{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de trabajo verificado: convierte objetivos en cambios de codigo demostrablemente correctos.",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "forge": "tsx packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
