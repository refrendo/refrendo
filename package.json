{
  "name": "refrendo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de trabajo verificado: convierte objetivos en cambios de codigo demostrablemente correctos.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "refrendo": "tsx packages/cli/src/index.ts",
    "build": "npm run build -w @refrendo/core && npm run build -w @refrendo/server && npm run build -w refrendo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refrendo/refrendo.git"
  },
  "bugs": {
    "url": "https://github.com/refrendo/refrendo/issues"
  },
  "homepage": "https://github.com/refrendo/refrendo",
  "publishConfig": {
    "access": "public"
  }
}